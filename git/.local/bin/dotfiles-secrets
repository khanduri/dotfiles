#!/usr/bin/env python3
"""Check staged changes with Gitleaks; install an opt-in repository hook safely."""
import argparse
from pathlib import Path
import shutil
import subprocess
import sys


def git(*args):
    result = subprocess.run(["git", *args], capture_output=True, text=True)
    if result.returncode:
        raise RuntimeError("Run this command inside a Git working tree.")
    return result.stdout.strip()


def check():
    scanner = shutil.which("gitleaks")
    if not scanner:
        scanner = next((str(p) for p in (Path("/opt/homebrew/bin/gitleaks"),
                       Path("/usr/local/bin/gitleaks")) if p.is_file()), None)
    if not scanner:
        raise RuntimeError("Install gitleaks (brew bundle); commit blocked until it is available.")
    # Scan the index, including partially staged files. Never scan backup refs.
    return subprocess.run([scanner, "git", "--staged", "--redact=100", "--no-banner",
                           "--log-level=warn"]).returncode


def install():
    git("rev-parse", "--show-toplevel")
    configured = subprocess.run(["git", "config", "--get", "core.hooksPath"], capture_output=True)
    if configured.returncode == 0:
        raise RuntimeError("Existing core.hooksPath retained. Add dotfiles-secrets check to your hook manager instead.")
    target = Path(git("rev-parse", "--git-path", "hooks/pre-commit")).absolute()
    source = Path(__file__).resolve()
    if target.is_symlink() and target.resolve() == source:
        print("Secret-scanning hook already installed.")
        return 0
    if target.exists() or target.is_symlink():
        raise RuntimeError("Existing pre-commit hook retained. Add dotfiles-secrets check to it instead.")
    target.parent.mkdir(parents=True, exist_ok=True)
    target.symlink_to(source)
    print("Installed secret-scanning pre-commit hook for this repository.")
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", nargs="?", choices=("check", "install"), default="check")
    return install() if parser.parse_args().action == "install" else check()


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, RuntimeError) as error:
        print("dotfiles-secrets: " + str(error), file=sys.stderr)
        sys.exit(1)
