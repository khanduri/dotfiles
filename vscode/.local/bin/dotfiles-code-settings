#!/usr/bin/env python3
"""Render shared VS Code JSON with explicit private overrides on another Mac."""
import argparse
import json
from pathlib import Path
import sys


def merge(base, override):
    result = dict(base)
    for key, value in override.items():
        if isinstance(value, dict) and isinstance(result.get(key), dict):
            result[key] = merge(result[key], value)
        else:
            result[key] = value
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--overrides", type=Path, required=True,
                        help="Private directory containing settings.json and keybindings.json (strict JSON)")
    parser.add_argument("--output", type=Path, required=True,
                        help="Local VS Code User directory; its two files will be replaced")
    args = parser.parse_args()
    package = Path(__file__).resolve().parents[2]
    source = package / "Library/Application Support/Code/User"
    checkout = package.parent
    rendered = {}
    for name in ("settings.json", "keybindings.json"):
        target = args.output / name
        if target.resolve().is_relative_to(checkout):
            parser.error("Output must not overwrite the shared checkout or its Stow symlinks")
        if target.resolve() == (args.overrides / name).resolve():
            parser.error("Keep private override inputs separate from generated output")
        base = json.loads((source / name).read_text())
        private = json.loads((args.overrides / name).read_text())
        expected = dict if name == "settings.json" else list
        if not isinstance(private, expected):
            parser.error("Private " + name + " has the wrong JSON type")
        value = merge(base, private) if expected is dict else base + private
        rendered[target] = json.dumps(value, indent=2) + "\n"
    # Validate both inputs and destinations before writing either output.
    args.output.mkdir(parents=True, exist_ok=True)
    for target, content in rendered.items():
        temporary = target.with_name(target.name + ".dotfiles-tmp")
        # Exclusive creation prevents following a preexisting link.
        with temporary.open("x") as stream:
            temporary.chmod(0o600)
            stream.write(content)
        temporary.replace(target)
    print("Applied shared VS Code settings and shortcuts with private overrides.")


if __name__ == "__main__":
    try:
        main()
    except (OSError, json.JSONDecodeError):
        print("Cannot read or write configuration. Check paths and strict JSON syntax; values were not logged.", file=sys.stderr)
        sys.exit(1)
